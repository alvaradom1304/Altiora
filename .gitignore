# Altiora: archivos locales, credenciales y resultados generados.
# .gitignore no elimina del indice archivos que Git ya sigue; revisar secretos historicos por separado.
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519
**/.env
**/.env.*
!**/.env.example
!**/.env.sample
!**/.env.template

# Dependencias, builds, cache y salidas temporales
node_modules/
**/node_modules/
.next/
dist/
build/
coverage/
out/
*.log
__pycache__/
*.pyc
.venv/
.pytest_cache/
.DS_Store
Thumbs.db

# Respaldos privados y material investigado no aprobado para commit
.altiora-private/
.references/
graphify-out/
graphify-out.old-*/
