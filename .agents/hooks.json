{
  "altiora-agent-system": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python ../.altiora/system/scripts/guard.py --runtime antigravity --project .. --event SessionStart",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python ../.altiora/system/scripts/guard.py --runtime antigravity --project .. --event PreToolUse",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
